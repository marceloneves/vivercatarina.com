---
import WhatsAppFloat from '../components/WhatsAppFloat.astro';
import WhatsAppLeadGate from '../components/WhatsAppLeadGate.astro';
import ConsentBanner from '../components/ConsentBanner.astro';
import {
	SITE_NAME,
	SITE_URL,
	SITE_EMAIL,
	SITE_WHATSAPP_NUMBER,
} from '../lib/site-contact.mjs';
import { resolvePageSeo } from '../lib/site-seo.mjs';
import fs from 'node:fs';
import crypto from 'node:crypto';

// Versão (hash do conteúdo) para cache-bust do hub.js: quando o arquivo
// muda, a URL muda e o navegador/CDN busca a versão nova em vez do cache.
const hubJsVersion = crypto
	.createHash('sha1')
	.update(fs.readFileSync('public/assets/js/hub.js'))
	.digest('hex')
	.slice(0, 8);

// Inline do CSS base (bootstrap + tema) para eliminar 2 requests
// render-blocking no carregamento inicial. Ordem preservada: bootstrap
// primeiro, tema depois (tema sobrescreve bootstrap).
const inlineBaseCss = ['public/assets/css/bootstrap.min.css', 'public/assets/css/style.css']
	.map((path) => fs.readFileSync(path, 'utf-8'))
	.join('\n')
	// @charset só é válido em folha externa; ao inline no <style> quebra a validação.
	.replace(/@charset\s+"[^"]*";/gi, '');

// Organization + WebSite sitewide. Resolve os @id (#organization / #website)
// referenciados por páginas como quem-somos. sameAs vazio até haver perfis
// sociais reais (evitar apontar para placeholders).
const organizationSchema = {
	'@context': 'https://schema.org',
	'@graph': [
		{
			'@type': 'Organization',
			'@id': `${SITE_URL}/#organization`,
			name: SITE_NAME,
			legalName: 'PMTurbo Tecnologia Ltda. ME',
			taxID: '54.008.386/0001-07',
			url: SITE_URL,
			logo: `${SITE_URL}/assets/img/logo.svg`,
			email: SITE_EMAIL,
			telephone: `+${SITE_WHATSAPP_NUMBER}`,
			areaServed: 'Santa Catarina, BR',
			sameAs: [
				'https://www.instagram.com/vivercatarina',
				'https://www.facebook.com/vivercatarina',
			],
		},
		{
			'@type': 'WebSite',
			'@id': `${SITE_URL}/#website`,
			url: SITE_URL,
			name: SITE_NAME,
			inLanguage: 'pt-BR',
			publisher: { '@id': `${SITE_URL}/#organization` },
		},
	],
};

interface Props {
	title: string;
	description?: string;
	keywords?: string;
	bodyClass?: string;
	disableEffects?: boolean;
	stylesheets?: string[];
	ogImage?: string;
	ogType?: string;
	canonicalPath?: string;
	noindex?: boolean;
}

const {
	title,
	description,
	keywords,
	bodyClass = '',
	disableEffects = false,
	stylesheets = [],
	ogImage,
	ogType,
	canonicalPath,
	noindex,
} = Astro.props;

const seo = resolvePageSeo({
	title,
	description,
	keywords,
	pathname: Astro.url.pathname,
	ogImage,
	ogType,
	canonicalPath,
	noindex,
});

const isHomePage = Astro.url.pathname === '/' || Astro.url.pathname === '/index.html';
const resolvedBodyClass = [bodyClass, isHomePage ? 'home-page' : 'site-dark-header']
	.filter(Boolean)
	.join(' ');
---

<!doctype html>
<html class="no-js" lang="pt-BR">
	<head>
		<meta charset="utf-8" />
		<meta http-equiv="x-ua-compatible" content="ie=edge" />
		<title>{seo.title}</title>
		<meta name="author" content={seo.author} />
		<meta name="publisher" content={seo.publisher} />
		<meta name="description" content={seo.description} />
		<meta name="keywords" content={seo.keywords} />
		<meta name="robots" content={seo.robots} />
		<meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
		<meta name="generator" content={Astro.generator} />
		<link rel="canonical" href={seo.canonicalUrl} />
		<meta property="og:locale" content="pt_BR" />
		<meta property="og:site_name" content={SITE_NAME} />
		<meta property="og:title" content={seo.ogTitle} />
		<meta property="og:description" content={seo.ogDescription} />
		<meta property="og:type" content={seo.ogType} />
		<meta property="og:url" content={seo.ogUrl} />
		<meta property="og:image" content={seo.ogImage} />
		<meta name="twitter:card" content={seo.twitterCard} />
		<meta name="twitter:title" content={seo.ogTitle} />
		<meta name="twitter:description" content={seo.ogDescription} />
		<meta name="twitter:image" content={seo.ogImage} />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />

		<link rel="apple-touch-icon" sizes="57x57" href="/assets/img/favicons/apple-icon-57x57.png" />
		<link rel="apple-touch-icon" sizes="60x60" href="/assets/img/favicons/apple-icon-60x60.png" />
		<link rel="apple-touch-icon" sizes="72x72" href="/assets/img/favicons/apple-icon-72x72.png" />
		<link rel="apple-touch-icon" sizes="76x76" href="/assets/img/favicons/apple-icon-76x76.png" />
		<link rel="apple-touch-icon" sizes="114x114" href="/assets/img/favicons/apple-icon-114x114.png" />
		<link rel="apple-touch-icon" sizes="120x120" href="/assets/img/favicons/apple-icon-120x120.png" />
		<link rel="apple-touch-icon" sizes="144x144" href="/assets/img/favicons/apple-icon-144x144.png" />
		<link rel="apple-touch-icon" sizes="152x152" href="/assets/img/favicons/apple-icon-152x152.png" />
		<link rel="apple-touch-icon" sizes="180x180" href="/assets/img/favicons/apple-icon-180x180.png" />
		<link rel="icon" type="image/png" sizes="192x192" href="/assets/img/favicons/android-icon-192x192.png" />
		<link rel="icon" type="image/png" sizes="32x32" href="/assets/img/favicons/favicon-32x32.png" />
		<link rel="icon" type="image/png" sizes="96x96" href="/assets/img/favicons/favicon-96x96.png" />
		<link rel="icon" type="image/png" sizes="16x16" href="/assets/img/favicons/favicon-16x16.png" />
		<link rel="manifest" href="/assets/img/favicons/manifest.json" />
		<meta name="msapplication-TileColor" content="#ffffff" />
		<meta name="msapplication-TileImage" content="/assets/img/favicons/ms-icon-144x144.png" />
		<meta name="theme-color" content="#FFAF00" />

		{isHomePage && (
			<link
				rel="preload"
				as="image"
				href="/assets/img/hero/vivercatarina-florianopolis.webp"
				fetchpriority="high"
			/>
		)}
		{/* Fontes self-hosted: preload das latin normais (texto/LCP) + @font-face inline. Sem render-block externo. */}
		<link rel="preload" as="font" type="font/woff2" href="/assets/fonts/google/inter-latin-normal.woff2" crossorigin />
		<link rel="preload" as="font" type="font/woff2" href="/assets/fonts/google/plusjakartasans-latin-normal.woff2" crossorigin />
		<style is:inline set:html={`@font-face{font-family:'Inter';font-style:italic;font-weight:100 900;font-display:swap;src:url(/assets/fonts/google/inter-latin-ext-italic.woff2) format('woff2');unicode-range:U+0100-02BA,U+02BD-02C5,U+02C7-02CC,U+02CE-02D7,U+02DD-02FF,U+0304,U+0308,U+0329,U+1D00-1DBF,U+1E00-1E9F,U+1EF2-1EFF,U+2020,U+20A0-20AB,U+20AD-20C0,U+2113,U+2C60-2C7F,U+A720-A7FF;}@font-face{font-family:'Inter';font-style:italic;font-weight:100 900;font-display:swap;src:url(/assets/fonts/google/inter-latin-italic.woff2) format('woff2');unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD;}@font-face{font-family:'Inter';font-style:normal;font-weight:100 900;font-display:swap;src:url(/assets/fonts/google/inter-latin-ext-normal.woff2) format('woff2');unicode-range:U+0100-02BA,U+02BD-02C5,U+02C7-02CC,U+02CE-02D7,U+02DD-02FF,U+0304,U+0308,U+0329,U+1D00-1DBF,U+1E00-1E9F,U+1EF2-1EFF,U+2020,U+20A0-20AB,U+20AD-20C0,U+2113,U+2C60-2C7F,U+A720-A7FF;}@font-face{font-family:'Inter';font-style:normal;font-weight:100 900;font-display:swap;src:url(/assets/fonts/google/inter-latin-normal.woff2) format('woff2');unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD;}@font-face{font-family:'Plus Jakarta Sans';font-style:italic;font-weight:200 800;font-display:swap;src:url(/assets/fonts/google/plusjakartasans-latin-ext-italic.woff2) format('woff2');unicode-range:U+0100-02BA,U+02BD-02C5,U+02C7-02CC,U+02CE-02D7,U+02DD-02FF,U+0304,U+0308,U+0329,U+1D00-1DBF,U+1E00-1E9F,U+1EF2-1EFF,U+2020,U+20A0-20AB,U+20AD-20C0,U+2113,U+2C60-2C7F,U+A720-A7FF;}@font-face{font-family:'Plus Jakarta Sans';font-style:italic;font-weight:200 800;font-display:swap;src:url(/assets/fonts/google/plusjakartasans-latin-italic.woff2) format('woff2');unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD;}@font-face{font-family:'Plus Jakarta Sans';font-style:normal;font-weight:200 800;font-display:swap;src:url(/assets/fonts/google/plusjakartasans-latin-ext-normal.woff2) format('woff2');unicode-range:U+0100-02BA,U+02BD-02C5,U+02C7-02CC,U+02CE-02D7,U+02DD-02FF,U+0304,U+0308,U+0329,U+1D00-1DBF,U+1E00-1E9F,U+1EF2-1EFF,U+2020,U+20A0-20AB,U+20AD-20C0,U+2113,U+2C60-2C7F,U+A720-A7FF;}@font-face{font-family:'Plus Jakarta Sans';font-style:normal;font-weight:200 800;font-display:swap;src:url(/assets/fonts/google/plusjakartasans-latin-normal.woff2) format('woff2');unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD;}`} />

		{/* Bootstrap + tema inline: sem request render-blocking no critical path. */}
		<style is:inline set:html={inlineBaseCss} />
		{/* Fallback com métricas ajustadas (Arial) para eliminar CLS no swap das fontes. */}
		<style
			is:inline
			set:html={`@font-face{font-family:'Inter Fallback';src:local('Arial');ascent-override:90.44%;descent-override:22.52%;line-gap-override:0%;size-adjust:107.12%}@font-face{font-family:'Inter Fallback';font-style:italic;src:local('Arial Italic'),local('Arial');ascent-override:90.44%;descent-override:22.52%;line-gap-override:0%;size-adjust:107.12%}@font-face{font-family:'Plus Jakarta Sans Fallback';src:local('Arial');ascent-override:87.66%;descent-override:18.75%;line-gap-override:0%;size-adjust:118.41%}@font-face{font-family:'Plus Jakarta Sans Fallback';font-style:italic;src:local('Arial Italic'),local('Arial');ascent-override:87.66%;descent-override:18.75%;line-gap-override:0%;size-adjust:118.41%}:root{--body-font:'Inter','Inter Fallback',Arial,sans-serif;--title-font:'Plus Jakarta Sans','Plus Jakarta Sans Fallback',Arial,sans-serif}`}
		/>
		{/* FontAwesome não é crítico para o render inicial: carrega sem bloquear. */}
		<link
			rel="stylesheet"
			href="/assets/css/fontawesome.min.css"
			media="print"
			onload="this.media='all'"
		/>
		<noscript><link rel="stylesheet" href="/assets/css/fontawesome.min.css" /></noscript>
		{stylesheets.map((href) => (
			<link rel="stylesheet" href={href} />
		))}
		<script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
		<slot name="head" />
	</head>
	<body class={resolvedBodyClass}>
		<a class="skip-link" href="#conteudo-principal">Ir para o conteúdo</a>
		<slot />
		<ConsentBanner />
		<WhatsAppLeadGate />
		<WhatsAppFloat />

		{/* Hub simples: só JS vanilla (menu, sticky, acordeão). Sem jQuery,
		   bootstrap.js, swiper, gsap etc. — o hub não usa nada disso. */}
		<script is:inline defer src={`/assets/js/hub.js?v=${hubJsVersion}`}></script>
	</body>
</html>
