---
import PillerLayout from '../layouts/PillerLayout.astro';
import BairroIntroSection from './BairroIntroSection.astro';
import PropertyListingTabs from './PropertyListingTabs.astro';
import { buildBairroPageContext } from '../lib/bairro-page.mjs';
import { SITE_URL } from '../lib/site-contact.mjs';

const { slug, page } = Astro.props;
const context = buildBairroPageContext(slug, page);

if (!context) {
	throw new Error(`Listagem de bairro não encontrada: ${slug}`);
}

const hasProperties = context.allProperties.length > 0;

const breadcrumbJsonLd = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [
		{ '@type': 'ListItem', position: 1, name: 'Início', item: `${SITE_URL}/` },
		{ '@type': 'ListItem', position: 2, name: 'Bairros', item: new URL('/bairros', SITE_URL).href },
		{
			'@type': 'ListItem',
			position: 3,
			name: context.listing.name,
			item: new URL(context.seo.canonicalPath, SITE_URL).href,
		},
	],
};
---

<PillerLayout
	title={context.seo.title}
	description={context.seo.description}
	keywords={context.seo.keywords}
	canonicalPath={context.seo.canonicalPath}
	bodyClass="bairro-listing"
	disableEffects
>
	<Fragment slot="head">
		<script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
	</Fragment>
	<Fragment set:html={context.shellBefore} />
	<BairroIntroSection
		name={context.listing.name}
		paragraphs={context.introParagraphs}
		hasProperties={hasProperties}
	/>
	<PropertyListingTabs
		properties={context.properties}
		allProperties={context.allProperties}
		currentPage={context.currentPage}
		totalPages={context.totalPages}
		basePath={context.basePath}
		sidebarHtml={context.sidebarHtml}
		showEmptyMessage={hasProperties}
		leadForm={{
			formId: `bairro-lead-${slug}`,
			variant: 'bairro',
			neighborhoodSlug: slug,
			neighborhoodName: context.listing.name,
			introText: `Receba oportunidades de imóveis na planta em ${context.listing.name}.`,
		}}
	/>
	<Fragment set:html={context.shellAfter} />
</PillerLayout>
