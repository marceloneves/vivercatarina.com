---
import { ui } from '../i18n/strings.mjs';

const { neighborhoods, cityRegions = [], variant = 'home', lang = 'pt', sideImage = false } = Astro.props;
const isListing = variant === 'listing';
const t = ui(lang);

// Lista única de todas as cidades, ordenada alfabeticamente (regiões ocultas
// temporariamente — cards exibidos num só grid de 4 por linha).
const allCities = cityRegions
	.flatMap((group) => group.cities)
	.sort((a, b) => a.name.localeCompare(b.name, 'pt-BR'));
---

{
	isListing ? (
		<section
			class="th-blog-wrapper space-top space-extra-bottom home-bairros-section"
			aria-labelledby="home-bairros-title"
		>
			<div class="container">
				<div class="th-sort-bar property-style">
					<div class="row justify-content-between align-items-center">
						<div class="col-md">
							<h1 class="box-title text-start bairro-listing-title" id="home-bairros-title">
								{t.bairros.listingTitle}
							</h1>
						</div>
					</div>
				</div>
				<p class="box-text bairros-listing-lead mb-4">
					{t.bairros.listingLead}
				</p>
				<div class="row gy-30 justify-content-center">
					{
						neighborhoods.map((item) => (
							<div class="col-xl-3 col-lg-4 col-md-6">
								<article class="gallery-card h-100">
									<a
										href={item.href}
										class="gallery-card-link"
									>
										<div class="gallery-img">
											<img
												src={item.imageUrl}
												alt=""
												aria-hidden="true"
												loading="lazy"
											/>
											<div class="gallery-content">
												<div class="gallery-content-wrapper">
													<p class="box-text">{item.region ?? 'Florianópolis, SC'}</p>
													<h2 class="box-title">{item.name}</h2>
												</div>
											</div>
										</div>
									</a>
								</article>
							</div>
						))
					}
				</div>
			</div>
		</section>
	) : (
		<section
			class="gallery-sec-1 home-bairros-section overflow-hidden space overflow-hidden"
			aria-labelledby="home-bairros-title"
		>
			<div class="container">
				<div class="row justify-content-center">
					<div class="col-xl-7">
						<div class="title-area text-center">
							<p class="sub-title">
								<span class="double-line" />
								{t.bairros.subTitle}
							</p>
							<h2 class="sec-title mb-2 home-headline" id="home-bairros-title">
								{t.bairros.titlePrefix}<br />
								<span class="title2 text-theme home-headline-italic">{t.bairros.highlight}</span>
							</h2>
							<p class="box-text">
								{t.bairros.text}
							</p>
						</div>
					</div>
				</div>
			</div>
			<div class="container pb-5">
				<ul class:list={["row gy-30 justify-content-start home-cities-list", { "home-cities-list--side": sideImage }]} aria-label={t.nav.cities}>
					{allCities.map((item) => (
						<li class="col-xl-3 col-lg-4 col-md-6">
							<article class="gallery-card h-100">
								<a href={item.href} class="gallery-card-link" target="_blank" rel="noopener noreferrer">
									<div class:list={["gallery-img", { "gallery-img--side": sideImage }]}>
										<img
											src={item.imageUrl}
											alt={t.cityImgAlt(item.name)}
											title={t.cityImgTitle(item.name)}
											loading="lazy"
										/>
									</div>
									<div class="gallery-content">
										<div class="gallery-content-wrapper">
											<h4 class="box-title">{item.name}</h4>
										</div>
									</div>
								</a>
							</article>
						</li>
					))}
				</ul>
			</div>
		</section>
	)
}

<style>
	/* Mais respiro nas laterais da seção de cards de cidades na home. */
	.home-bairros-section .container {
		padding-left: clamp(16px, 4vw, 72px);
		padding-right: clamp(16px, 4vw, 72px);
	}

	/* Lista de cidades sem marcador (bolinha) nem recuo. Sem mexer nas margens
	   do .row do bootstrap (senão o gutter gy-30 não é cancelado na 1ª fileira). */
	.home-bairros-section .home-cities-list {
		list-style: none;
		padding-left: 0.75rem;
		margin-bottom: 0;
	}

	/* Títulos de cada região (segmentação dos cards de cidade). */
	.home-bairros-section .home-region-group + .home-region-group {
		margin-top: 3.75rem;
	}

	/* "Santa Catarina" em itálico no título da seção. */
	.home-bairros-section .home-headline-italic {
		font-style: italic;
	}

	.home-bairros-section .home-region-title {
		font-size: 1.4rem;
		font-weight: 700;
		font-style: italic;
		margin-bottom: 2rem;
		color: var(--title-color);
		display: inline-block;
		background: var(--theme-color);
		padding: 4px 10px;
		box-shadow: -4px 4px 0 0 #000000;
	}

	.home-bairros-section .gallery-card {
		height: 100%;
	}

	/* Efeito esfumaçado preto somente na área do nome, na base do card. */
	.home-bairros-section .gallery-content {
		left: 0;
		right: 0;
		bottom: 0;
		width: 100%;
		transform: none;
		border-radius: 0;
		z-index: 2;
		background: linear-gradient(
			to top,
			rgba(0, 0, 0, 1) 0%,
			rgba(0, 0, 0, 0.85) 45%,
			rgba(0, 0, 0, 0.4) 80%,
			rgba(0, 0, 0, 0) 100%
		);
	}

	.home-bairros-section .gallery-content-wrapper {
		padding: 28px 16px 12px;
	}

	/* Remove o fundo branco que aparecia atrás do nome no hover. */
	.home-bairros-section .gallery-content-wrapper::before {
		display: none;
	}

	/* Nome da cidade menor dentro da faixa. */
	.home-bairros-section .gallery-content .box-title {
		font-size: 18px;
		font-weight: 700;
	}

	.home-bairros-section .gallery-card-link {
		display: block;
		height: 100%;
		color: inherit;
		text-decoration: none;
		cursor: pointer;
	}

	.home-bairros-section .gallery-img {
		position: relative;
		aspect-ratio: 4 / 3;
		width: 100%;
		max-height: none;
		height: auto;
		border-radius: 0;
		/* Borda preta simples em toda a volta + faixa amarela por fora na esquerda e embaixo. */
		border: 1px solid #000000;
		box-shadow: -6px 6px 0 0 var(--theme-color);
	}

	/* Cards de cidade sem cantos arredondados. */
	.home-bairros-section .gallery-img img {
		border-radius: 0;
	}

	/* Remove o escurecimento global da imagem; só a faixa do nome fica escura. */
	.home-bairros-section .gallery-img::before {
		display: none;
	}

	.home-bairros-section .gallery-img img {
		position: absolute;
		inset: 0;
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center;
		/* Tom âmbar da marca para padronizar fotos de origens diferentes. */
		filter: sepia(0.5) saturate(1.32) hue-rotate(-10deg) brightness(1.02);
		transition: transform 0.4s ease;
	}

	/* Camada âmbar da marca sobre a foto reforça o tom uniforme. */
	.home-bairros-section .gallery-img::after {
		content: "";
		position: absolute;
		inset: 0;
		background: var(--theme-color);
		mix-blend-mode: multiply;
		opacity: 0.14;
		pointer-events: none;
		z-index: 1;
	}

	/* Mantém o zoom suave da imagem no hover. */
	.home-bairros-section .gallery-card-link:hover .gallery-img img,
	.home-bairros-section .gallery-card-link:focus-visible .gallery-img img {
		transform: scale(1.05);
	}

	/* No hover, muda a cor do nome da cidade para o amarelo da marca. */
	.home-bairros-section .gallery-card .gallery-img:hover .gallery-content .box-title,
	.home-bairros-section .gallery-card-link:hover .gallery-content .box-title,
	.home-bairros-section .gallery-card-link:focus-visible .gallery-content .box-title {
		color: var(--theme-color);
	}

	.home-bairros-section .gallery-card-link:focus-visible {
		outline: 2px solid var(--theme-color);
		outline-offset: 4px;
		border-radius: 8px;
	}

	/* Menos espaço no topo da seção (antes do título). */
	.gallery-sec-1.home-bairros-section {
		padding-top: 60px;
		padding-bottom: 40px;
	}

	/* TESTE: nome da cidade abaixo do card (só home). */
	.gallery-sec-1 .gallery-content {
		position: static;
		background: none;
	}
	.gallery-sec-1 .gallery-content-wrapper {
		padding: 18px 4px 0;
		text-align: center;
	}
	.gallery-sec-1 .gallery-content .box-title {
		color: #1a1a1a;
	}

	/* ===== Variação v2: imagem da cidade à esquerda (1/3), nome à direita ===== */
	/* Card vira linha horizontal; borda e faixa amarela envolvem o card todo. */
	.home-bairros-section .home-cities-list--side .gallery-card-link {
		display: flex;
		align-items: stretch;
		position: relative;
		min-height: 96px;
		border: 2px solid #000000;
		box-shadow: -6px 6px 0 0 var(--theme-color);
		background-color: color-mix(in srgb, var(--theme-color) 8%, #ffffff);
	}

	/* Imagem ocupa 1/3 da esquerda; sem borda/sombra próprias. */
	.home-bairros-section .gallery-img--side {
		flex: 0 0 33.333%;
		max-width: 33.333%;
		align-self: stretch;
		aspect-ratio: auto;
		border: none;
		box-shadow: none;
	}

	/* Nome centralizado nos 2/3 da direita. */
	.home-bairros-section .home-cities-list--side .gallery-content {
		flex: 1 1 auto;
		position: static;
		display: flex;
		align-items: center;
		justify-content: center;
		background: none;
		padding: 0;
	}
	.home-bairros-section .home-cities-list--side .gallery-content-wrapper {
		padding: 12px 14px;
		text-align: center;
	}
	.home-bairros-section .home-cities-list--side .gallery-content .box-title {
		font-size: 18px;
		font-weight: 700;
		color: #1a1a1a;
	}

	/* Hover: nome permanece escuro (fundo já é claro). */
	.home-bairros-section .home-cities-list--side .gallery-card-link:hover .gallery-content .box-title,
	.home-bairros-section .home-cities-list--side .gallery-card-link:focus-visible .gallery-content .box-title {
		color: #1a1a1a;
	}
</style>
