---

const { neighborhoods, cityRegions = [], variant = 'home' } = Astro.props;
const isListing = variant === 'listing';
---

{
	isListing ? (
		<section
			class="th-blog-wrapper space-top space-extra-bottom home-bairros-section"
			aria-labelledby="home-bairros-title"
		>
			<div class="container">
				<div class="th-sort-bar property-style">
					<div class="row justify-content-between align-items-center">
						<div class="col-md">
							<h1 class="box-title text-start bairro-listing-title" id="home-bairros-title">
								Bairros em Florianópolis
							</h1>
						</div>
					</div>
				</div>
				<p class="box-text bairros-listing-lead mb-4">
					Encontre o lançamento imobiliário em Florianópolis ideal para você
				</p>
				<div class="row gy-30 justify-content-center">
					{
						neighborhoods.map((item) => (
							<div class="col-xl-3 col-lg-4 col-md-6">
								<article class="gallery-card h-100">
									<a
										href={item.href}
										class="gallery-card-link"
									>
										<div class="gallery-img">
											<img
												src={item.imageUrl}
												alt=""
												aria-hidden="true"
												loading="lazy"
											/>
											<div class="gallery-content">
												<div class="gallery-content-wrapper">
													<p class="box-text">{item.region ?? 'Florianópolis, SC'}</p>
													<h2 class="box-title">{item.name}</h2>
												</div>
											</div>
										</div>
									</a>
								</article>
							</div>
						))
					}
				</div>
			</div>
		</section>
	) : (
		<section
			class="gallery-sec-1 home-bairros-section overflow-hidden space overflow-hidden"
			aria-labelledby="home-bairros-title"
		>
			<div class="container">
				<div class="row justify-content-center">
					<div class="col-xl-7">
						<div class="title-area text-center">
							<p class="sub-title">
								<span class="double-line" />
								Imóveis na planta
							</p>
							<h2 class="sec-title mb-2 home-headline" id="home-bairros-title">
								Encontre seu Imóvel em{' '}
								<span class="title2 text-theme home-headline-italic">Santa Catarina</span>
							</h2>
							<p class="box-text">
								Encontre lançamentos imobiliários nas principais cidades de Santa Catarina
							</p>
						</div>
					</div>
				</div>
			</div>
			<div class="container pb-5">
				{
					cityRegions.map((group) => (
						<div class="home-region-group">
							<h3 class="home-region-title">{group.region}</h3>
							<div class="row gy-30 justify-content-start">
								{group.cities.map((item) => (
									<div class="col-xl-3 col-lg-4 col-md-6">
										<article class="gallery-card h-100">
											<a href={item.href} class="gallery-card-link">
												<div class="gallery-img">
													<img
														src={item.imageUrl}
														alt=""
														aria-hidden="true"
														loading="lazy"
													/>
													<div class="gallery-content">
														<div class="gallery-content-wrapper">
															<h2 class="box-title">{item.name}</h2>
														</div>
													</div>
												</div>
											</a>
										</article>
									</div>
								))}
							</div>
						</div>
					))
				}
			</div>
		</section>
	)
}

<style>
	/* Mais respiro nas laterais da seção de cards de cidades na home. */
	.home-bairros-section .container {
		padding-left: clamp(16px, 4vw, 72px);
		padding-right: clamp(16px, 4vw, 72px);
	}

	/* Títulos de cada região (segmentação dos cards de cidade). */
	.home-bairros-section .home-region-group + .home-region-group {
		margin-top: 2.75rem;
	}

	/* "Santa Catarina" em itálico no título da seção. */
	.home-bairros-section .home-headline-italic {
		font-style: italic;
	}

	.home-bairros-section .home-region-title {
		font-size: 1.375rem;
		font-weight: 700;
		margin-bottom: 1.5rem;
		color: var(--title-color);
	}

	/* 5 cards por linha a partir de telas grandes. */
	@media (min-width: 1200px) {
		.home-bairros-section .home-region-group .row > [class*='col-'] {
			flex: 0 0 20%;
			max-width: 20%;
		}
	}

	.home-bairros-section .gallery-card {
		height: 100%;
	}

	/* Efeito esfumaçado preto somente na área do nome, na base do card. */
	.home-bairros-section .gallery-content {
		left: 0;
		right: 0;
		bottom: 0;
		width: 100%;
		transform: none;
		border-radius: 0;
		background: linear-gradient(
			to top,
			rgba(0, 0, 0, 1) 0%,
			rgba(0, 0, 0, 0.85) 45%,
			rgba(0, 0, 0, 0.4) 80%,
			rgba(0, 0, 0, 0) 100%
		);
	}

	.home-bairros-section .gallery-content-wrapper {
		padding: 28px 16px 12px;
	}

	/* Remove o fundo branco que aparecia atrás do nome no hover. */
	.home-bairros-section .gallery-content-wrapper::before {
		display: none;
	}

	/* Nome da cidade menor dentro da faixa. */
	.home-bairros-section .gallery-content .box-title {
		font-size: 18px;
	}

	.home-bairros-section .gallery-card-link {
		display: block;
		height: 100%;
		color: inherit;
		text-decoration: none;
		cursor: pointer;
	}

	.home-bairros-section .gallery-img {
		position: relative;
		aspect-ratio: 4 / 3;
		width: 100%;
		max-height: none;
		height: auto;
		border-radius: 0;
		/* Borda preta em toda a volta + faixa amarela por fora na esquerda e embaixo. */
		border: 1px solid #000000;
		box-shadow: -6px 6px 0 0 var(--theme-color);
	}

	/* Cards de cidade sem cantos arredondados. */
	.home-bairros-section .gallery-img img {
		border-radius: 0;
	}

	/* Remove o escurecimento global da imagem; só a faixa do nome fica escura. */
	.home-bairros-section .gallery-img::before {
		display: none;
	}

	.home-bairros-section .gallery-img img {
		position: absolute;
		inset: 0;
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center;
		transition: transform 0.4s ease;
	}

	/* Mantém o zoom suave da imagem no hover. */
	.home-bairros-section .gallery-card-link:hover .gallery-img img,
	.home-bairros-section .gallery-card-link:focus-visible .gallery-img img {
		transform: scale(1.05);
	}

	/* No hover, muda a cor do nome da cidade para o amarelo da marca. */
	.home-bairros-section .gallery-card .gallery-img:hover .gallery-content .box-title,
	.home-bairros-section .gallery-card-link:hover .gallery-content .box-title,
	.home-bairros-section .gallery-card-link:focus-visible .gallery-content .box-title {
		color: var(--theme-color);
	}

	.home-bairros-section .gallery-card-link:focus-visible {
		outline: 2px solid var(--theme-color);
		outline-offset: 4px;
		border-radius: 8px;
	}
</style>
