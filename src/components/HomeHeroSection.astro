---
import { getHomeHeroBackgroundUrl } from '../lib/home-page.mjs';
import { ui } from '../i18n/strings.mjs';

const { lang = 'pt' } = Astro.props;
const t = ui(lang);
const heroBackgroundUrl = getHomeHeroBackgroundUrl();
---

<section class="th-hero-wrapper hero-1" id="hero" aria-label={t.aria.heroMain}>
	<div
		class="hero-inner hero-style1 background-image"
		style={`background-image: url("${heroBackgroundUrl}")`}
	>
		<div class="container">
			<div class="row gy-50 gx-40 align-items-center">
				<div class="col-xxl-7 col-xl-7 col-lg-8">
					<div class="hero-1-content pe-xl-4">
						<h1 class="hero-title">
							{t.hero.prefix}<br />
							<span class="title2 text-theme">{t.hero.highlight}</span>
						</h1>
						<p class="hero-subtitle">
							{t.hero.subtitle}
						</p>
					</div>
				</div>
			</div>
		</div>
	</div>
</section>

<style>
	/* Mantém "Santa Catarina" sempre na mesma linha. */
	.hero-title .title2 {
		white-space: nowrap;
	}

	/* Cor de fundo sólida escura no wrapper (sem imagem): é o que o Lighthouse
	   usa para calcular o contraste do texto sobre a foto. Fica invisível pois
	   a imagem da hero cobre, mas garante base escura para o amarelo passar. */
	.th-hero-wrapper.hero-1 {
		background-color: var(--gray-color);
	}

	/* Overlay mais escuro atrás do texto para o amarelo passar no contraste
	   (WCAG), mantendo a foto visível à direita. */
	.hero-1 .hero-style1::before {
		background: linear-gradient(
			90deg,
			rgba(3, 6, 14, 0.92),
			rgba(3, 6, 14, 0.45) 55%,
			transparent
		);
		opacity: 1;
	}

	/* Aumenta a margem esquerda do texto da hero e dá respiro no topo. */
	.hero-1-content {
		padding-left: clamp(16px, 4vw, 64px);
		padding-top: clamp(24px, 5vw, 72px);
	}

	/* Reduz o espaço entre o título e o subtítulo. */
	.hero-title {
		margin-bottom: 0;
	}

	/* Subtítulo pequeno abaixo do título da hero. */
	.hero-subtitle {
		margin-top: 14px;
		margin-bottom: 0;
		font-size: clamp(0.95rem, 1.2vw, 1.125rem);
		font-weight: 400;
		color: rgba(255, 255, 255, 0.9);
	}
</style>
