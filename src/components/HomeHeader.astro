---
import { ui } from '../i18n/strings.mjs';
import { localizedPath, ptPathFromEs, languageSwitcher } from '../i18n/routes.mjs';
import { buildCitiesMenuHtml } from '../lib/footer-cities.mjs';

const { lang = 'pt' } = Astro.props;
const t = ui(lang);
// Menu "Cidades" com o endereço (subdomínio) correto de cada cidade — mesma
// fonte de dados do rodapé. Rótulo localizado (Cidades/Ciudades).
const citiesMenuHtml = buildCitiesMenuHtml(t.nav.cities);
const homeHref = localizedPath(lang, '/');
const aboutHref = localizedPath(lang, '/quem-somos');
const contactHref = localizedPath(lang, '/contato');
const partnerHref = localizedPath(lang, '/seja-um-parceiro');

// Seletor de idioma: computa a rota PT canônica desta página para gerar os
// alternates PT/ES.
const here = Astro.url.pathname;
const ptPath = lang === 'es' ? ptPathFromEs(here) || '/' : here;
const langs = languageSwitcher(lang, ptPath);

// Item do menu correspondente à página atual (barra final é irrelevante).
const normalizePath = (path) => path.replace(/\/+$/, '') || '/';
const isActive = (href) => normalizePath(href) === normalizePath(here);
const activeClass = (href) => (isActive(href) ? 'active' : undefined);
---

<!--********************************
   		Code Start From Here
	******************************** -->

    <!--==============================
    Sidemenu
============================== -->
<!--==============================
    Mobile Menu
  ============================== -->
    <div class="th-menu-wrapper">
        <div class="th-menu-area text-center">
            <button class="th-menu-toggle" aria-label={t.aria.openMenu}><i class="fas fa-times"></i></button>
            <div class="mobile-logo">
                <a href={homeHref} aria-label={t.aria.homeLogo}><img src="/assets/img/logo.svg" alt="Logotipo Viver Catarina" title="Viver Catarina" width="200" height="42"></a>
            </div>
            <nav class="th-mobile-menu" aria-label={t.aria.mobileMenu}>
                <ul>
                    <li class={activeClass(homeHref)}><a href={homeHref} aria-current={isActive(homeHref) ? 'page' : undefined}>{t.nav.home}</a></li>
                    <li class={activeClass(aboutHref)}><a href={aboutHref} aria-current={isActive(aboutHref) ? 'page' : undefined}>{t.nav.about}</a></li>
                    <Fragment set:html={citiesMenuHtml} />
                    <li class={activeClass(contactHref)}><a href={contactHref} aria-current={isActive(contactHref) ? 'page' : undefined}>{t.nav.contact}</a></li>
                </ul>
            </nav>
        </div>
    </div>
    <!--==============================
	Header Area
==============================-->
    <header class="th-header header-default header-layout1">
        <div class="header-top">
            <div class="container">
                <div class="row justify-content-center justify-content-lg-between align-items-center gy-2">
                    <div class="col-auto d-none d-lg-block">
                        <nav class="header-links" aria-label={t.aria.contactSocial}><ul aria-label={t.aria.siteContacts}>
                                <li><i class="fa-solid fa-envelope"></i> <a href="mailto:contato@vivercatarina.com">contato@vivercatarina.com</a></li>
                                <li><i class="fa-brands fa-whatsapp"></i> <a href="tel:+5548988105199" data-whatsapp-lead data-whatsapp-source="phone">(48) 98810-5199</a></li>
                            </ul>
                        </nav>
                    </div>

                    <div class="col-auto header-top-right">
                        <nav class="header-links" aria-label={t.aria.contactSocial}><ul aria-label={t.aria.siteContacts}>
                                <li>
                                    <div class="th-social">
                                        <a href="https://www.facebook.com/vivercatarina" aria-label="Facebook"><i class="fab fa-facebook-f"></i></a>
                                        <a href="https://www.instagram.com/vivercatarina" target="_blank" rel="noopener noreferrer" aria-label="Instagram"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 448 512" width="16" height="16" fill="currentColor" aria-hidden="true"><path d="M224.1 141c-63.6 0-114.9 51.3-114.9 114.9s51.3 114.9 114.9 114.9S339 319.5 339 255.9 287.7 141 224.1 141zm0 189.6c-41.1 0-74.7-33.5-74.7-74.7s33.5-74.7 74.7-74.7 74.7 33.5 74.7 74.7-33.6 74.7-74.7 74.7zm146.4-194.3c0 14.9-12 26.8-26.8 26.8-14.9 0-26.8-12-26.8-26.8s12-26.8 26.8-26.8 26.8 12 26.8 26.8zm76.1 27.2c-1.7-35.9-9.9-67.7-36.2-93.9-26.2-26.2-58-34.4-93.9-36.2-37-2.1-147.9-2.1-184.9 0-35.8 1.7-67.6 9.9-93.9 36.1s-34.4 58-36.2 93.9c-2.1 37-2.1 147.9 0 184.9 1.7 35.9 9.9 67.7 36.2 93.9s58 34.4 93.9 36.2c37 2.1 147.9 2.1 184.9 0 35.9-1.7 67.7-9.9 93.9-36.2 26.2-26.2 34.4-58 36.2-93.9 2.1-37 2.1-147.8 0-184.8zM398.8 388c-7.8 19.6-22.9 34.7-42.6 42.6-29.5 11.7-99.5 9-132.1 9s-102.7 2.6-132.1-9c-19.6-7.8-34.7-22.9-42.6-42.6-11.7-29.5-9-99.5-9-132.1s-2.6-102.7 9-132.1c7.8-19.6 22.9-34.7 42.6-42.6 29.5-11.7 99.5-9 132.1-9s102.7-2.6 132.1 9c19.6 7.8 34.7 22.9 42.6 42.6 11.7 29.5 9 99.5 9 132.1s2.7 102.7-9 132.1z"/></svg></a>
                                        <a href="https://wa.me/5548988105199" aria-label="WhatsApp"><i class="fab fa-whatsapp"></i></a>
                                       </div>
                                </li>
                                </ul>
                        </nav>
                        <nav class="header-lang-switch" aria-label={t.aria.langSwitcher}>
                            {langs.filter((l) => !l.current && l.href).map((l) => (
                                <a
                                    href={l.href}
                                    hreflang={l.lang}
                                    class="header-lang-switch__link"
                                >{t.langSwitchLabel}</a>
                            ))}
                        </nav>
                    </div>
                </div>
            </div>
        </div>
        <div class="sticky-wrapper">
            <!-- Main Menu Area -->
            <div class="menu-area">
                <div class="container">
                    <div class="row align-items-center justify-content-between">
                        <div class="col-auto">
                            <div class="header-logo">
                                <a href={homeHref} aria-label={t.aria.homeLogo}><img src="/assets/img/logo-white.svg" alt="Logotipo Viver Catarina" title="Viver Catarina" width="200" height="42"></a>
                            </div>
                        </div>
                        <div class="col-auto mx-auto">
                            <nav class="main-menu d-none d-lg-inline-block" aria-label={t.aria.mainMenu}>
                                <ul>
                                    <li class={activeClass(homeHref)}><a href={homeHref} aria-current={isActive(homeHref) ? 'page' : undefined}>{t.nav.home}</a></li>
                                    <li class={activeClass(aboutHref)}><a href={aboutHref} aria-current={isActive(aboutHref) ? 'page' : undefined}>{t.nav.about}</a></li>
                                    <Fragment set:html={citiesMenuHtml} />
                                    <li class={activeClass(contactHref)}><a href={contactHref} aria-current={isActive(contactHref) ? 'page' : undefined}>{t.nav.contact}</a></li>
                                </ul>
                            </nav>
                            <button type="button" class="th-menu-toggle d-block d-lg-none" aria-label={t.aria.openMenu}><i class="fas fa-bars"></i></button>
                        </div>
                        <div class="col-auto d-none d-lg-block">
                            <div class="header-button">
                                <a href={partnerHref} class="th-btn sm radius">{t.nav.partnerBtn}</a>
                            </div>
                        </div>
                </div>
            </div>
        </div>
    </header>

<style is:global>
	/* Seletor de idioma discreto no topo do header. */
	.header-top-right {
		display: flex;
		align-items: center;
	}
	.header-lang-switch {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		margin-left: 16px;
		padding-left: 16px;
		border-left: 1px solid rgba(255, 255, 255, 0.25);
	}
	.header-lang-switch__link {
		font-size: 12px;
		font-weight: 700;
		letter-spacing: 0.06em;
		line-height: 1;
		text-decoration: none;
		opacity: 0.7;
	}
	.header-lang-switch__link:hover {
		opacity: 1;
	}

	/* Botão "Seja um Parceiro" (slot header-button, fora do .main-menu): estilo do fln. */
	.header-button .th-btn {
		border-radius: 0 !important;
		color: #000000 !important;
		background-color: var(--theme-color) !important;
		font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif !important;
		font-size: 13px !important;
		font-weight: 700 !important;
		letter-spacing: 0.12em !important;
		line-height: 1 !important;
		text-transform: none !important;
		padding: 12px 36px !important;
		min-width: 120px !important;
	}
</style>

