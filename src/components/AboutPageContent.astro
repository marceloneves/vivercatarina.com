---
import {
	SITE_EMAIL,
	SITE_NAME,
	SITE_PHONE_DISPLAY,
	SITE_WHATSAPP_NUMBER,
} from '../lib/site-contact.mjs';
import { applyGlossaryInlineLinks } from '../lib/glossary-content-links.mjs';

// Página quem-somos não deve ter links internos de glossário no corpo.
function linkify(text) {
	return text;
}

const differentiators = [
	{
		title: 'Foco exclusivo em SC',
		text: linkify(
			'Não somos um portal nacional que trata Santa Catarina como mais um estado. Somos catarinenses, conhecemos cada cidade que cobrimos e entendemos o mercado local como ninguém.',
		),
		icon: '/assets/img/icon/about-1-1.svg',
	},
	{
		title: 'Informação de qualidade',
		text: linkify(
			`Cada empreendimento cadastrado no ${SITE_NAME} passa pela nossa curadoria. Plantas, preços, destaques e localização — tudo verificado e apresentado de forma clara.`,
		),
		icon: '/assets/img/icon/about-1-3.svg',
	},
	{
		title: 'Tecnologia a serviço do comprador',
		text: linkify(
			'Usamos inteligência artificial para manter as informações sempre atualizadas e para entregar ao comprador exatamente o que ele precisa saber antes de tomar uma decisão.',
		),
		icon: '/assets/img/icon/about-1-4.svg',
	},
	{
		title: 'Cobertura das 23 maiores cidades',
		text: linkify(
			'De Joinville a Criciúma, de Balneário Camboriú a Chapecó — cobrimos as 23 maiores cidades de Santa Catarina com páginas dedicadas, informações locais e lançamentos verificados.',
		),
		icon: '/assets/img/icon/about-3-1.svg',
	},
];

const stats = [
	{ value: '23', label: 'cidades cobertas em SC' },
	{ value: '6', label: 'regiões do estado' },
	{ value: '3', label: 'categorias de imóvel' },
	{ value: '1', label: 'missão: conectar você ao seu próximo lar' },
];

const introParagraphs = [
	linkify(
		`O <strong>${SITE_NAME}</strong> nasceu da visão de que encontrar um lançamento de qualidade em Florianópolis merecia algo melhor do que informações genéricas e desatualizadas. Reunimos curadoria cuidadosa e tecnologia para apresentar cada empreendimento com clareza, direto para quem busca o imóvel ideal na cidade.`,
	),
	'Somos um time de profissionais que conhece Santa Catarina de perto — seus bairros, suas construtoras, suas oportunidades. Sabemos que cada cidade tem seu ritmo, seu perfil de comprador e seus lançamentos com potencial real. E foi exatamente essa visão local que nos motivou a criar o maior portal especializado em lançamentos imobiliários do estado.',
];

const missionText = linkify(
	'Conectar quem quer comprar um imóvel novo em Florianópolis a corretores e imobiliárias credenciados no CRECI, com informação completa, transparente e atualizada sobre cada lançamento da cidade.',
);

const partnersText = linkify(
	`O ${SITE_NAME} é o canal ideal para divulgar seu lançamento para compradores qualificados em todo o estado.`,
);

const contactIntroText = linkify(
	'Seja você um comprador buscando o imóvel ideal ou uma incorporadora querendo divulgar um lançamento, estamos aqui para ajudar.',
);
---

<section class="about-1-wrapper space-top space-bottom overflow-hidden" id="about-sec" aria-labelledby="about-intro-title">
	<div class="container">
		<div class="row justify-content-center">
			<div class="col-xl-10 col-lg-11">
				<div class="title-area text-center mb-40">
					<p class="sub-title"><span class="double-line"></span> Quem Somos</p>
					<h1 class="sec-title" id="about-intro-title">Viva o melhor de Santa Catarina</h1>
				</div>
				<div class="about-page-intro text-center">
					<p class="sec-text mb-4" set:html={introParagraphs[0]} />
					<p class="sec-text mb-0" set:html={introParagraphs[1]} />
				</div>
			</div>
		</div>
	</div>
</section>

<section class="space overflow-hidden bg-smoke" aria-labelledby="about-mission-title">
	<div class="container">
		<div class="row justify-content-center">
			<div class="col-xl-8 col-lg-10 text-center">
				<div class="title-area mb-30">
					<p class="sub-title"><span class="double-line"></span> Propósito</p>
					<h2 class="sec-title" id="about-mission-title">Nossa missão</h2>
				</div>
				<p class="sec-text mb-0" set:html={missionText} />
			</div>
		</div>
	</div>
</section>

<section class="why-sec-2 space overflow-hidden about-differentiators" id="why-sec" aria-labelledby="about-diff-title">
	<div class="container">
		<div class="row justify-content-center mb-40">
			<div class="col-xl-8 text-center">
				<div class="title-area mb-2">
					<p class="sub-title"><span class="double-line"></span> Diferenciais</p>
					<h2 class="sec-title" id="about-diff-title">O que nos diferencia</h2>
				</div>
			</div>
		</div>
		<div class="row justify-content-center">
			<div class="col-xl-10 col-lg-11">
				<div class="row gy-30 gx-4 gx-xl-5 about-differentiators-grid">
					{
						differentiators.map((item) => (
							<div class="col-xl-6">
								<div class="about-1-item h-100">
									<div class="icon">
										<img src={item.icon} alt={`Ícone ilustrativo: ${item.title}`} title={item.title} />
									</div>
									<div class="content">
										<h3 class="box-title">{item.title}</h3>
										<p class="box-text" set:html={item.text} />
									</div>
								</div>
							</div>
						))
					}
				</div>
			</div>
		</div>
	</div>
</section>

<section class="counter-sec1 space overflow-hidden" aria-labelledby="about-stats-title" data-bg-src="/assets/img/hero/vivercatarina-florianopolis.webp" style="background-image:url('/assets/img/hero/vivercatarina-florianopolis.webp')">
	<div class="container">
		<div class="row justify-content-center mb-40">
			<div class="col-xl-8 text-center">
				<div class="title-area mb-0">
					<p class="sub-title text-white"><span class="double-line"></span> Em números</p>
					<h2 class="sec-title text-white" id="about-stats-title">Nossos números</h2>
				</div>
			</div>
		</div>
		<div class="counter-card-wrap style2">
			{
				stats.map((stat, index) => (
					<>
						{index > 0 && <div class="divider" />}
						<div class="counter-card">
							<div class="media-body text-center">
								<p class="box-number">
									<span>{stat.value}</span>
								</p>
								<p class="box-text">{stat.label}</p>
							</div>
						</div>
					</>
				))
			}
		</div>
	</div>
</section>

<section class="space overflow-hidden" aria-labelledby="about-partners-title">
	<div class="container">
		<div class="row justify-content-center">
			<div class="col-xl-8 col-lg-10 text-center">
				<div class="title-area mb-30">
					<p class="sub-title"><span class="double-line"></span> Parcerias</p>
					<h2 class="sec-title" id="about-partners-title">Para incorporadoras e construtoras</h2>
				</div>
				<p class="sec-text mb-4" set:html={partnersText} />
				<a href="/contato" class="th-btn style2 pill">Entrar em Contato</a>
			</div>
		</div>
	</div>
</section>

<style>
	.about-page-intro .sec-text {
		max-width: 820px;
		margin-left: auto;
		margin-right: auto;
	}

	.about-differentiators .about-differentiators-grid {
		padding-inline: clamp(0.75rem, 2.5vw, 2.5rem);
	}

	.about-differentiators .about-1-item {
		padding: 1.5rem 1.25rem;
		/* Mesmo creme dos sites de cidade (igual FAQ/contato). */
		background-color: #F5F2ED;
	}

	/* Remove o espaço no topo antes da seção "Quem Somos / Viva o melhor". */
	.about-1-wrapper.space-top {
		padding-top: 0;
	}

	/* Fundo creme dos sites de cidade na seção "Nossa missão" (igual FAQ/cards). */
	section.bg-smoke[aria-labelledby="about-mission-title"] {
		background-color: #F5F2ED !important;
	}

	@media (min-width: 1200px) {
		.about-differentiators .about-1-item {
			padding: 1.75rem 1.5rem;
		}
	}

	#about-contact .contact-feature_link {
		color: inherit;
	}

	.counter-sec1 .counter-card .box-text {
		max-width: 180px;
		margin-left: auto;
		margin-right: auto;
	}

	.th-btn {
		border-radius: 0;
	}

	.th-btn::before {
		border-radius: 0;
	}

	/* No hover o fundo do botão ficava branco (sumia na seção branca):
	   mantém a cor da marca. */
	.th-btn.style2:hover::before,
	.th-btn.style2:hover::after {
		background-color: var(--theme-color);
	}

	/* Hero de Florianópolis é foto clara: overlay escuro + texto branco
	   para o bloco "Nossos números" ficar legível. */
	.counter-sec1 {
		position: relative;
	}

	.counter-sec1::before {
		content: '';
		position: absolute;
		inset: 0;
		z-index: 0;
		background: rgba(0, 0, 0, 0.55);
		pointer-events: none;
	}

	.counter-sec1 > .container {
		position: relative;
		z-index: 1;
	}

	.counter-sec1 .title-area .sub-title,
	.counter-sec1 .title-area .sec-title,
	.counter-sec1 .counter-card .box-number,
	.counter-sec1 .counter-card .box-number span,
	.counter-sec1 .counter-card .box-text {
		color: #fff !important;
	}
</style>
