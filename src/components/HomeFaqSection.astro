---
import { ui } from '../i18n/strings.mjs';
import { localizedPath } from '../i18n/routes.mjs';

const { items, lang = 'pt' } = Astro.props;
const accordionId = 'homeFaqAccordion';
const t = ui(lang);
const contactHref = localizedPath(lang, '/contato');
---

<section class="space overflow-hidden bg-smoke home-faq-section" id="home-faq" aria-labelledby="home-faq-title">
	<div class="container">
		<div class="row justify-content-between gy-4">
			<div class="col-lg-5 col-xl-5">
				<div class="title-area text-left">
					<p class="sub-title"><span class="double-line"></span> {t.faq.subTitle}</p>
					<h2 class="sec-title" id="home-faq-title">{t.faq.title}</h2>
					<p class="sec-text">
						{t.faq.intro}
					</p>
					<a href={contactHref} class="th-btn style3 fale-conosco-invert">{t.faq.cta}</a>
				</div>
			</div>
			<div class="col-lg-7 col-xl-7">
				<div class="accordion-1 accordion" id={accordionId}>
					{
						items.map(({ question, answer }, index) => {
							const itemNumber = index + 1;
							const isOpen = index === 0;
							const collapseId = `home-faq-collapse-${itemNumber}`;
							const headerId = `home-faq-header-${itemNumber}`;

							return (
								<div class={`accordion-card${isOpen ? ' active' : ''}`}>
									<div class="accordion-header" id={headerId}>
										<button
											class={`accordion-button${isOpen ? '' : ' collapsed'}`}
											type="button"
											data-bs-toggle="collapse"
											data-bs-target={`#${collapseId}`}
											aria-expanded={isOpen ? 'true' : 'false'}
											aria-controls={collapseId}
										>
											<span class="serial-numb">{itemNumber}. </span>
											{question}
										</button>
									</div>
									<div
										id={collapseId}
										role="region"
										class={`accordion-collapse collapse${isOpen ? ' show' : ''}`}
										aria-labelledby={headerId}
										data-bs-parent={`#${accordionId}`}
									>
										<div class="accordion-body">
											<p class="faq-text">{answer}</p>
										</div>
									</div>
								</div>
							);
						})
					}
				</div>
			</div>
		</div>
	</div>
</section>

<style>
	/* Fundo amarelo da marca clareado na seção de dúvidas. */
	.home-faq-section.bg-smoke {
		background-color: color-mix(in srgb, var(--theme-color) 8%, #ffffff) !important;
	}

	.home-faq-section .title-area {
		margin-bottom: 0;
	}

	.home-faq-section .sec-text {
		margin-bottom: 1.5rem;
	}

	/* Borda preta espessa em cada pergunta (card do accordion). */
	.home-faq-section .accordion-card {
		border: 3px solid #000000;
	}

	/* Cores invertidas do botão Fale conosco: fundo preto, texto amarelo. */
	.th-btn.style3.fale-conosco-invert {
		background-color: #000000 !important;
		color: var(--theme-color) !important;
		border-color: #000000 !important;
	}
	.th-btn.style3.fale-conosco-invert:hover {
		background-color: var(--theme-color) !important;
		color: #000000 !important;
		border-color: var(--theme-color) !important;
	}
</style>
