---
import { ui } from '../i18n/strings.mjs';
import { localizedPath } from '../i18n/routes.mjs';

const { lang = 'pt' } = Astro.props;
const t = ui(lang);
const homeHref = localizedPath(lang, '/');
const aboutHref = localizedPath(lang, '/quem-somos');
const contactHref = localizedPath(lang, '/contato');
const privacyHref = localizedPath(lang, '/privacidade');
const termsHref = localizedPath(lang, '/termos');
const cookiesHref = localizedPath(lang, '/politica-de-cookies');
---

<!--==============================
	Footer Area
==============================-->
    </main>
    <footer class="footer-wrapper footer-default">
        <div class="widget-area">
            <div class="container">
                <div class="footer-all-widget-wrapper">
                    <div class="footer-all-widget-item">
                        <div class="widget footer-widget">
                            <div class="th-widget-about">
                                <div class="about-logo">
                                    <a href={homeHref} aria-label={t.footer.logoAria}><img src="/assets/img/logo-white.svg" alt="Logotipo Viver Catarina" title="Viver Catarina" width="220" height="44"></a>
                                </div>
                                <p class="about-text">{t.footer.aboutText}</p></div>
                        </div>
                    </div>
                    <div class="footer-all-widget-item">
                        
                            
                                                                                                <div class="footer-item">
                                    <nav class="widget widget_nav_menu footer-widget" aria-labelledby="footer-nav-institucional"><h3 class="widget_title" id="footer-nav-institucional">{t.footer.colInstitutional}</h3>
                                        <div class="menu-all-pages-container">
                                            <ul class="menu">
                                                <li><a href={homeHref}>{t.footer.linkHome}</a></li>
                                                <li><a href={aboutHref}>{t.footer.linkAbout}</a></li>
                                                <li><a href={contactHref}>{t.footer.linkContact}</a></li>
                                                <li><a href="/sitemap-index.xml">{t.footer.linkSitemap}</a></li>
                                            </ul>
                                        </div>
                                    </nav>
                                </div>
                                <div class="footer-item">
                                    <nav class="widget widget_nav_menu footer-widget" aria-labelledby="footer-nav-florianopolis"><h3 class="widget_title" id="footer-nav-florianopolis" style="text-transform:none">{t.footer.colLegal}</h3>
                                        <div class="menu-all-pages-container">
                                            <ul class="menu">
                                                <li><a href={privacyHref}>{t.footer.linkPrivacy}</a></li>
                                                <li><a href={termsHref}>{t.footer.linkTerms}</a></li>
                                                <li><a href={cookiesHref}>{t.footer.linkCookies}</a></li>
                                            </ul>
                                        </div>
                                    </nav>
                                </div>
                                <div class="footer-item">
                                    <div class="widget footer-widget footer-contact-widget" role="group" aria-labelledby="footer-nav-contato">
                                        <h3 class="widget_title" id="footer-nav-contato">{t.footer.colContact}</h3>
                                        <address class="footer-info-wrap">
                                            <div class="footer-info">
                                                <i class="fab fa-whatsapp"></i>
                                                <p class="info-box_link"><a href="tel:+5548988105199" data-whatsapp-lead data-whatsapp-source="phone">(48) 98810-5199</a></p>
                                            </div>
                                            <div class="footer-info">
                                                <i class="fas fa-envelope"></i>
                                                <p class="info-box_link"><a href="mailto:contato@vivercatarina.com">contato@vivercatarina.com</a></p>
                                            </div>
                                            <div class="footer-info">
                                                <i class="fas fa-location-dot"></i>
                                                <p class="info-box_link"><span>Florianópolis, SC</span></p>
                                            </div>
                                        </address>
                                    </div>
                                </div>
                                
                            
                            
                        </div>
                    </div>
                </div>
            </div>
                                <section class="footer-cities-section" aria-label="Cidades atendidas">
            <div class="container">
                <div class="footer-cities-wrap">
                    <h3 class="widget_title">{t.footer.colCities}</h3>
                    <div class="footer-cities-regions">
                        <div class="footer-cities-region">
                            <h4 class="footer-cities-region-title">Grande Florianópolis</h4>
                            <ul class="footer-cities-list">
                                <li><a href="https://florianopolis.vivercatarina.com" target="_blank" rel="noopener">Florianópolis</a></li>
                                <li><a href="https://saojose.vivercatarina.com" target="_blank" rel="noopener">São José</a></li>
                                <li><a href="https://palhoca.vivercatarina.com" target="_blank" rel="noopener">Palhoça</a></li>
                                <li><a href="https://biguacu.vivercatarina.com" target="_blank" rel="noopener">Biguaçu</a></li>
                                <li><a href="https://tijucas.vivercatarina.com" target="_blank" rel="noopener">Tijucas</a></li>
                            </ul>
                        </div>
                        <div class="footer-cities-region">
                            <h4 class="footer-cities-region-title">Norte Catarinense</h4>
                            <ul class="footer-cities-list">
                                <li><a href="https://joinville.vivercatarina.com" target="_blank" rel="noopener">Joinville</a></li>
                                <li><a href="https://jaraguadosul.vivercatarina.com" target="_blank" rel="noopener">Jaraguá do Sul</a></li>
                                <li><a href="https://barravelha.vivercatarina.com" target="_blank" rel="noopener">Barra Velha</a></li>
                                <li><a href="https://penha.vivercatarina.com" target="_blank" rel="noopener">Penha</a></li>
                                <li><a href="https://picarras.vivercatarina.com" target="_blank" rel="noopener">Balneário Piçarras</a></li>
                            </ul>
                        </div>
                        <div class="footer-cities-region">
                            <h4 class="footer-cities-region-title">Vale do Itajaí e Litoral</h4>
                            <ul class="footer-cities-list">
                                <li><a href="https://balneario.vivercatarina.com" target="_blank" rel="noopener">Balneário Camboriú</a></li>
                                <li><a href="https://itajai.vivercatarina.com" target="_blank" rel="noopener">Itajaí</a></li>
                                <li><a href="https://blumenau.vivercatarina.com" target="_blank" rel="noopener">Blumenau</a></li>
                                <li><a href="https://brusque.vivercatarina.com" target="_blank" rel="noopener">Brusque</a></li>
                                <li><a href="https://camboriu.vivercatarina.com" target="_blank" rel="noopener">Camboriú</a></li>
                                <li><a href="https://itapema.vivercatarina.com" target="_blank" rel="noopener">Itapema</a></li>
                                <li><a href="https://navegantes.vivercatarina.com" target="_blank" rel="noopener">Navegantes</a></li>
                                <li><a href="https://portobelo.vivercatarina.com" target="_blank" rel="noopener">Porto Belo</a></li>
                                <li><a href="https://bombinhas.vivercatarina.com" target="_blank" rel="noopener">Bombinhas</a></li>
                            </ul>
                        </div>
                        <div class="footer-cities-region">
                            <h4 class="footer-cities-region-title">Sul Catarinense</h4>
                            <ul class="footer-cities-list">
                                <li><a href="https://criciuma.vivercatarina.com" target="_blank" rel="noopener">Criciúma</a></li>
                                <li><a href="https://tubarao.vivercatarina.com" target="_blank" rel="noopener">Tubarão</a></li>
                                <li><a href="https://imbituba.vivercatarina.com" target="_blank" rel="noopener">Imbituba</a></li>
                            </ul>
                        </div>
                        <div class="footer-cities-region">
                            <h4 class="footer-cities-region-title">Oeste Catarinense</h4>
                            <ul class="footer-cities-list">
                                <li><a href="https://chapeco.vivercatarina.com" target="_blank" rel="noopener">Chapecó</a></li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </section>
<div class="copyright-wrap">
            <div class="footer-bottom-top-shape animation-infinite" data-bg-src="/assets/img/icon/footer-bottom-top-shape.png"></div>
            <div class="container">
                <p class="footer-disclaimer">{t.footer.disclaimer}</p>
                                <div class="row gy-3 justify-content-lg-between justify-content-center align-items-center footer-copyright-row">
                    <div class="col-auto footer-copyright-email">
                        <p class="copyright-email"><a href="mailto:contato@vivercatarina.com">contato@vivercatarina.com</a></p>
                    </div>
                    <div class="col-lg-7 footer-copyright-center">
                        <p class="copyright-text">2025-2026 - <a href={homeHref}>Viver Catarina</a> - {t.footer.rights}</p>
                    </div>
                    <div class="col-auto footer-copyright-social">

                        <div class="footer-default-copy-right">
                            <p>{t.footer.socialLabelSite}</p>
                            <div class="th-social">
                                <a href="https://www.facebook.com/vivercatarina" aria-label="Facebook"><i class="fab fa-facebook-f"></i></a>
                                <a href="https://www.instagram.com/vivercatarina" aria-label="Instagram"><i class="fab fa-instagram"></i></a>
                                <a href="https://wa.me/5548988105199" aria-label="WhatsApp"><i class="fab fa-whatsapp"></i></a>
                                                   </div>
                </div>
                    </div>
                </div>
            </div>
        </div>
    </footer>

    <!--********************************
			Code End  Here
	******************************** -->

<style is:global>
	/* Sem ícone nos itens do menu do rodapé. */
	.footer-widget.widget_nav_menu a::before {
		content: none !important;
	}
	.footer-widget.widget_nav_menu a {
		padding-left: 0 !important;
	}
	/* Ícone › (igual Florianópolis) só antes do título do menu. */
	.footer-widget.widget_nav_menu .widget_title::before {
		content: "\f105";
		font-family: var(--icon-font);
		font-weight: 400;
		color: var(--theme-color);
		margin-right: 8px;
		display: inline-block;
		/* Zera a linha/traço do tema que ficava no ::before do título. */
		background: none;
		height: auto;
		width: auto;
		border-radius: 0;
		position: static;
	}
	/* Mesmo ícone › antes do título de cidades e do contato. */
	.footer-cities-wrap .widget_title::before,
	.footer-contact-widget .widget_title::before {
		content: "\f105";
		font-family: var(--icon-font);
		font-weight: 400;
		color: var(--theme-color);
		margin-right: 8px;
		display: inline-block;
		/* Zera a linha/traço do tema que ficava no ::before do título. */
		background: none;
		height: auto;
		width: auto;
		border-radius: 0;
		position: static;
	}
	/* Sem sublinhado nos links de contato do rodapé. */
	.footer-contact-widget a {
		text-decoration: none !important;
	}
	/* Sem itálico no telefone, e-mail e cidade (o <address> é itálico por padrão). */
	.footer-contact-widget .footer-info-wrap {
		font-style: normal;
	}
</style>

    