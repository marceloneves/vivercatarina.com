---
import { SITE_EMAIL } from '../lib/site-contact.mjs';
---

<section class="space partner-contact" aria-labelledby="partner-contact-title">
	<div class="container">
		<div class="row justify-content-center">
			<div class="col-xl-8 col-lg-10">
				<div class="partner-contact__card">
					<h1 class="sec-title mb-2" id="partner-contact-title">
						Quero ser <span class="bairro-name-accent">parceiro</span>
					</h1>
					<p class="partner-contact__lead" data-partner-lead>
						Preencha os dados abaixo e nossa equipe entrará em contato.
					</p>

					<form class="partner-contact__form" id="partner-contact-form" novalidate>
						<div class="partner-contact__field">
							<label for="partner-perfil">Sou</label>
							<select id="partner-perfil" name="perfil" required>
								<option value="" disabled selected>Selecione seu perfil</option>
								<option value="corretor">Corretor de Imóveis</option>
								<option value="imobiliaria">Imobiliária</option>
								<option value="incorporadora">Incorporadora / Construtora</option>
							</select>
						</div>

						<div class="partner-contact__field">
							<label for="partner-name">Nome / Razão social</label>
							<input type="text" id="partner-name" name="name" placeholder="Seu nome ou razão social" required />
						</div>

						<div class="partner-contact__field">
							<label for="partner-phone">Telefone</label>
							<input type="tel" id="partner-phone" name="phone" placeholder="(48) 99999-9999" required />
						</div>

						<div class="partner-contact__field">
							<label for="partner-email">E-mail</label>
							<input type="email" id="partner-email" name="email" placeholder="seu@email.com" required />
						</div>

						<div class="partner-contact__field">
							<label for="partner-message">Mensagem <span class="partner-contact__opt">(opcional)</span></label>
							<textarea id="partner-message" name="message" rows="4" placeholder="Conte um pouco sobre você ou sua empresa"></textarea>
						</div>

						<p class="partner-contact__error" id="partner-contact-error" hidden></p>

						<button type="submit" class="th-btn">Enviar contato</button>
						<p class="form-consent-note" style="font-size:11px;line-height:1.45;margin:8px 0 0;color:var(--body-color);text-align:center;">Ao enviar, você concorda em ser contatado via WhatsApp/e-mail. Veja nossa <a href="/privacidade" target="_blank" rel="noopener">Política de Privacidade</a>.</p>
					</form>
				</div>
			</div>
		</div>
	</div>
</section>

<style>
	.partner-contact__card {
		padding: 40px;
		border: 1px solid var(--black-color);
		background: var(--white-color);
	}
	.partner-contact__lead {
		margin-bottom: 28px;
	}
	.partner-contact__field {
		margin-bottom: 18px;
	}
	.partner-contact__field label {
		display: block;
		margin-bottom: 8px;
		font-weight: 600;
	}
	.partner-contact__opt {
		font-weight: 400;
		color: #777;
	}
	.partner-contact__field input,
	.partner-contact__field textarea,
	.partner-contact__field select {
		width: 100%;
		padding: 12px 16px;
		border: 1px solid var(--th-border-color);
		border-radius: 0;
		background: var(--white-color);
		color: var(--title-color);
		font-size: 15px;
	}
	.partner-contact__error {
		margin-bottom: 14px;
		color: #c0392b;
		font-weight: 600;
	}
	.partner-contact .th-btn {
		border-radius: 0 !important;
	}
	.partner-contact__hint {
		margin-top: 12px;
		margin-bottom: 0;
		font-size: 13px;
		color: #777;
	}
	@media (max-width: 575px) {
		.partner-contact__card {
			padding: 24px;
		}
	}
</style>

<script define:vars={{ siteEmail: SITE_EMAIL }}>
	(function () {
		const PERFIS = {
			incorporadora: 'Incorporadora / Construtora',
			imobiliaria: 'Imobiliária',
			corretor: 'Corretor de Imóveis',
		};

		const form = document.getElementById('partner-contact-form');
		if (!form) return;

		const errorEl = document.getElementById('partner-contact-error');
		const showError = (msg) => {
			if (!errorEl) return;
			errorEl.textContent = msg;
			errorEl.hidden = false;
		};

		form.addEventListener('submit', (event) => {
			event.preventDefault();
			const name = form.name.value.trim();
			const phone = form.phone.value.trim();
			const email = form.email.value.trim();
			const message = form.message.value.trim();

			const perfil = form.perfil.value;
			const perfilNome = PERFIS[perfil];
			if (!perfilNome) {
				showError('Selecione seu perfil (corretor, imobiliária ou incorporadora/construtora).');
				return;
			}
			if (!name || !phone || !email) {
				showError('Preencha nome, telefone e e-mail.');
				return;
			}
			if (errorEl) errorEl.hidden = true;

			const subject = `Parceria Viver Catarina - ${perfilNome}`;
			const bodyLines = [
				`Perfil: ${perfilNome}`,
				`Nome / Razão social: ${name}`,
				`Telefone: ${phone}`,
				`E-mail: ${email}`,
				'',
				'Mensagem:',
				message || '(não informada)',
			];
			const mailto = `mailto:${siteEmail}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(bodyLines.join('\n'))}`;
			window.location.href = mailto;
		});
	})();
</script>
