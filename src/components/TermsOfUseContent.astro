<section class="space overflow-hidden legal-page" aria-labelledby="terms-title">
	<div class="container">
		<div class="row justify-content-center">
			<div class="col-xl-9 col-lg-10">
				<div class="title-area text-center mb-40">
					<p class="sub-title"><span class="double-line"></span> Condições gerais</p>
					<h1 class="sec-title" id="terms-title">Termos de Uso</h1>
