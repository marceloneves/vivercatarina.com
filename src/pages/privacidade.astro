import SiteFooter from '../components/SiteFooter.astro';
import PrivacyPolicyContent from '../components/PrivacyPolicyContent.astro';
---

<PillerLayout title="Política de Privacidade e LGPD | Viver Catarina" description="Saiba como o portal Viver Catarina trata seus dados pessoais conforme a LGPD: dados coletados, finalidade, compartilhamento, retenção e seus direitos." canonicalPath="/privacidade" stylesheets={['/css/internal-links.css']} disableEffects>
	<SiteHeader breadcrumb="Política de Privacidade" />
	<PrivacyPolicyContent />
	<SiteFooter />
</PillerLayout>
