---
import PillerLayout from '../layouts/PillerLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
---

<PillerLayout title="Página não encontrada" noindex disableEffects>
	<SiteHeader />
	<section class="bg-smoke space">
		<div class="container">
			<div class="row justify-content-center">
				<div class="col-lg-7 text-center">
					<h1 class="error-title">Erro 404</h1>
					<p class="error-text">A página que você procura não existe ou foi movida.</p>
					<a href="/" class="th-btn">Voltar ao início</a>
				</div>
			</div>
		</div>
	</section>
	<SiteFooter />
</PillerLayout>
