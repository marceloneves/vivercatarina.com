---
import PillerLayout from '../layouts/PillerLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import AboutPageContent from '../components/AboutPageContent.astro';
import { SITE_URL } from '../lib/site-contact.mjs';

const aboutPageSchema = {
	'@context': 'https://schema.org',
	'@type': 'AboutPage',
	'@id': `${SITE_URL}/quem-somos#webpage`,
	url: `${SITE_URL}/quem-somos`,
	name: 'Quem Somos — Viver Catarina',
	inLanguage: 'pt-BR',
	about: { '@id': `${SITE_URL}/#organization` },
	isPartOf: { '@id': `${SITE_URL}/#website` },
};
---

<PillerLayout title="Quem Somos e Como Funciona o Portal | Viver Catarina" description="Conheça o Viver Catarina, portal que reúne lançamentos e imóveis na planta nas principais cidades de Santa Catarina e conecta você a corretores do CRECI." canonicalPath="/quem-somos" bodyClass="about-page" stylesheets={['/css/internal-links.css']} disableEffects>
	<Fragment slot="head"><script type="application/ld+json" set:html={JSON.stringify(aboutPageSchema)} /></Fragment>
	<SiteHeader breadcrumb="Quem Somos" />
	<AboutPageContent />
	<SiteFooter />
</PillerLayout>
