# Servido pelo LiteSpeed em produção (não Vercel). Copiado de public/ -> dist/ no build.

# ==========================================================
# C4 — Canonicalização de host/protocolo
# ==========================================================
<IfModule mod_rewrite.c>
	RewriteEngine On

	# HTTP -> HTTPS (apex e subdomínios). LiteSpeed expõe HTTPS via %{HTTPS}.
	RewriteCond %{HTTPS} !=on
	RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

	# www -> apex. Só remove o prefixo "www."; não afeta subdomínios de cidade
	# (florianopolis., balneario. etc.).
	RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
	RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

	Redirect 301 /contact /contato

	# Inventário de imóveis/bairros/lançamentos removido do hub (virou só
	# agregador de cidades). 301 dessas URLs para a home.
	RewriteRule ^(imovel|property|bairro|bairros|lancamentos|glossario)(/.*)?/?$ / [R=301,L]
</IfModule>

# ==========================================================
# H6 — Security headers
# Sem guard <IfModule mod_headers.c>: o LiteSpeed suporta a diretiva Header mas
# nem sempre satisfaz o teste do nome de módulo Apache, o que fazia o bloco ser
# pulado silenciosamente. Diretivas diretas.
# ==========================================================
# HSTS: força HTTPS por 1 ano em todos os subdomínios.
# "preload" omitido de propósito (commitment quase irreversível — submeter
# manualmente à lista de preload só depois de validar todos os subdomínios).
Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set X-Frame-Options "SAMEORIGIN"
Header always set Permissions-Policy "geolocation=(), camera=(), microphone=()"
# CSP deixado de fora: o site usa scripts inline (is:inline), Google Fonts,
# Google Maps iframe e WhatsApp — uma CSP restritiva quebraria isso. Definir
# depois, com testes, uma política com allowlist explícita.

# ==========================================================
# Cache de assets estáticos (mod_expires). Guardado: se o host não tiver o
# módulo, o bloco é ignorado sem quebrar. Assets têm hash/rotam no deploy.
# ==========================================================
<IfModule mod_expires.c>
	ExpiresActive On
	ExpiresByType text/css "access plus 1 year"
	ExpiresByType application/javascript "access plus 1 year"
	ExpiresByType image/webp "access plus 1 year"
	ExpiresByType image/svg+xml "access plus 1 year"
	ExpiresByType image/png "access plus 1 year"
	ExpiresByType image/jpeg "access plus 1 year"
	ExpiresByType font/woff2 "access plus 1 year"
</IfModule>
